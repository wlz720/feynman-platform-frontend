{
  "name": "feynman-platform-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "基于 AI 的费曼学习平台前端（React + Vite）",
  "author": "韦丽珍",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "build:electron": "vite build --base ./",
    "electron:build": "npm run build:electron && electron-builder"
  },
  "build": {
    "appId": "com.feynman.platform",
    "productName": "Feynman Learning Platform",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "axios": "^1.20.0",
    "d3-force-3d": "^3.0.6",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.1.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "mermaid": "^12.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-media-recorder": "^1.7.2",
    "react-router-dom": "^7.18.4",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "wait-on": "^9.5.1"
  }
}
